{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "composite": true,
    "rootDir": "..",
    "paths": {
      "@alexovn/okapi": ["../lib/src/index.ts"],
      "@alexovn/okapi/fetch": ["../lib/src/adapters/fetch.ts"],
      "@alexovn/okapi/axios": ["../lib/src/adapters/axios.ts"],
      "@alexovn/okapi/ofetch": ["../lib/src/adapters/ofetch.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts", "test", "../lib/src"]
}
