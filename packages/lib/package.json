    "axios": { "optional": true },
    "ofetch": { "optional": true }
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.52.0",
    "axios": "^1.18.1",
    "ofetch": "^1.5.1",
    "typescript": "~6.0.2",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.0.12"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  }
}
