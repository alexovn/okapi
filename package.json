{
  "name": "@alexovn/okapi-workspace",
  "private": true,
  "scripts": {
    "build:lib": "pnpm --filter @alexovn/okapi build",
    "dev:playground": "pnpm --filter @alexovn/okapi-playground dev",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "pnpm run lint:fix",
    "*": "pnpm run fmt --no-error-on-unmatched-pattern",
    "packages/lib/**/*.{js,ts}": "pnpm --filter @alexovn/okapi exec vitest related --run"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0"
  }
}
